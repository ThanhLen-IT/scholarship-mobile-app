<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. CÁC QUYỀN MẠNG & THÔNG BÁO CHO HỆ THỐNG -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Quyền thông báo (Cho Android 13+ / Task 31) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Quyền hẹn giờ báo thức Deadline chính xác (Task 32) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Quyền đọc ảnh từ thư viện cho việc tải mã QR Mentor (Task 26) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScholarshipGateway"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 2. CÁC ACTIVITY CỦA APP -->


        <!-- Màn hình khởi chạy đầu tiên: LoginActivity -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Các màn hình chức năng tiếp theo -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.GroupChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ScholarshipDetailActivity"
            android:exported="false" />

        <!-- 3. SERVICE ĐỒNG BỘ CHAT NGẦM (Task 30) -->
        <service
            android:name=".services.ChatSyncService"
            android:enabled="true"
            android:exported="false" />

        <!-- 4. BROADCAST RECEIVERS LẮNG NGHE SỰ KIỆN (Task 29 & 32) -->
        <!-- Lắng nghe rớt mạng/có mạng -->
        <receiver
            android:name=".receivers.NetworkChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Bắt giờ hẹn Deadline -->
        <receiver
            android:name=".receivers.DeadlineAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>